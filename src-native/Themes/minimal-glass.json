{
  "schemaVersion": "1.0.0",
  "name": "Minimal Glass",
  "author": "Vanced Converse Team",
  "description": "Ultra-lightweight frosted glass with neutral subtle borders.",
  "window": {
    "backgroundType": "acrylic",
    "backgroundColor": "#0d1117",
    "opacity": 0.70,
    "blurRadius": 30,
    "acrylicTint": "#080a0f",
    "acrylicLuminosity": 0.5,
    "cornerRadius": 20,
    "borderWidth": 1.0,
    "borderColor": "#ffffff22",
    "borderGlowColor": "#ffffff22",
    "borderGlowRadius": 10,
    "borderGlowIntensity": 0.3,
    "padding": 14,
    "edgeFadeMargin": 16
  },
  "messageBubble": {
    "background": "#161b22",
    "opacity": 0.75,
    "cornerRadius": 14,
    "padding": 10,
    "margin": 4,
    "spacing": 6,
    "maxWidth": 420,
    "borderWidth": 1.0,
    "borderColor": "#ffffff15"
  },
  "typography": {
    "fontFamily": "Segoe UI Variable, Segoe UI, sans-serif",
    "fontSize": 13,
    "fontWeight": "Normal",
    "lineHeight": 1.35,
    "authorColor": "#79c0ff",
    "messageColor": "#f0f6fc",
    "modBadgeColor": "#56d364",
    "superchatColor": "#e3b341"
  },
  "textEffects": {
    "strokeEnabled": false,
    "strokeWidth": 0.5,
    "strokeColor": "#000000",
    "glowEnabled": false,
    "glowColor": "#ffffff",
    "glowRadius": 4,
    "glowIntensity": 0.2,
    "shadowEnabled": true,
    "shadowColor": "#00000088",
    "shadowBlur": 3,
    "shadowOffsetX": 0,
    "shadowOffsetY": 1,
    "gradientFillEnabled": false
  }
}
